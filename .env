APP_NAME="TA-Stunting FE"
APP_ENV=local
APP_KEY=base64:SSgn3W9oZlelGG1ENVUTKq21VdAdvz/WSdGIIrl3VxI=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Backend API base URL (inside Docker network, use service name)
API_BASE_URL=http://web:80/api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# No DB in FE — use file-based session only
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

VITE_APP_NAME="${APP_NAME}"

API_STORAGE_URL=http://localhost:8001/storage
